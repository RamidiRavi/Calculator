    {
      "parameters": {
        "jsCode": "let articles = [];\ntry {\n  articles = JSON.parse($('Fetch Articles Index1').item.json.data);\n} catch (e) {\n  articles = [];\n}\n\nconst compiled = $('Compile HTML File').item.json;\n\n// Add new article metadata to the top\narticles.unshift({\n  title: compiled.title,\n  summary: compiled.summary,\n  url: `articles/${compiled.slug}.html`,\n  date: compiled.date,\n  category: compiled.category\n});\n\n// Cap at 30 articles to prevent file growing too large\nif (articles.length > 30) {\n  articles = articles.slice(0, 30);\n}\n\nreturn {\n  jsonContent: JSON.stringify(articles, null, 2)\n};"
      },
