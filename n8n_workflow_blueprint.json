            },
            {
              "role": "system",
              "content": "=You are an expert copywriter. Generate a high-quality article responding to this news. The article must relate to the tool: {{ $('Check Relevance').item.json.output[0].content[0].text }}\nEnsure the output is in JSON format matching this exact schema:\n{\n  \"title\": \"Catchy SEO Page Title (under 60 chars)\",\n  \"metaDescription\": \"Compelling description (under 155 chars)\",\n  \"category\": \"Finance, Health, or Productivity\",\n  \"headline\": \"Powerful, engaging headline for the article\",\n  \"body\": \"HTML formatted article body using <p>, <h2>, <ul>, <li>. Do not write full html page, just the article body. Must be highly informative, professional, and contain 3-4 paragraphs with solid advice.\",\n  \"slug\": \"url-safe-lowercase-slug-without-html-extension (e.g. mortgage-rates-spike)\",\n  \"embeddedCalculatorLink\": \"<a href=\\\"../calculators/loan.html\\\" class=\\\"btn btn-primary\\\">Open Loan & Interest Calculator &rarr;</a>\" (select matching tool path: loan.html, calorie.html, or days.html)\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
