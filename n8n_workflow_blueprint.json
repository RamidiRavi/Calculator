    {
      "parameters": {
        "jsCode": "let aiText = $('Generate Article Content').item.json.output[0].content[0].text;\n\n// Remove markdown json blocks\naiText = aiText\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\n// Convert text to JSON\nconst aiData = JSON.parse(aiText);\n\nconst template = $('Fetch HTML Template').item.json.data;\n\nconst todayStr = new Date().toLocaleDateString('en-US', { \n  year: 'numeric',\n  month: 'long',\n  day: 'numeric'\n});\n\nlet compiledHtml = template\n  .replace(/{title}/g, aiData.title || '')\n  .replace(/{meta-description}/g, aiData.metaDescription || '')\n  .replace(/{category}/g, aiData.category || '')\n  .replace(/{date}/g, todayStr)\n  .replace(/{article-headline}/g, aiData.headline || '')\n  .replace(/{article-body}/g, aiData.body || '')\n  .replace(/{embedded-calculator-link}/g, aiData.embeddedCalculatorLink || '');\n\nreturn [\n  {\n    json: {\n      html: compiledHtml,\n      slug: aiData.slug,\n      title: aiData.headline,\n      summary: aiData.metaDescription,\n      category: aiData.category,\n      date: todayStr\n    }\n  }\n];"
      },
