{
  "name": "InterestCalcs RSS Content Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "id": "node_schedule_trig",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://247wallst.com/feed/"
      },
      "id": "node_rss_read",
      "name": "Get RSS Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "maxItems": 1
      },
      "id": "node_limit",
      "name": "Get Latest Article",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        200,
        200
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "content": "=News Title: {{ $json.title }}\nNews Summary: {{ $json.contentSnippet }}"
            },
            {
              "role": "system",
              "content": "You are a content filtering agent for a site called InterestCalcs.\nWe have three interactive tools on our site:\n1. 💰 Loan & Compound Interest Calculator (for mortgage, rates, debt, loans, interest, inflation news)\n2. 🥗 Calorie Deficit & Fitness Calculator (for nutrition, FDA, diet, fitness, calories, fat loss trends)\n3. 📅 Days Between Dates Calculator (for deadlines, project timing, date differences, calendar adjustments)\n\nAnalyze the incoming news title/summary. Is this news article relevant to one of these three categories? \nRespond in strict JSON format:\n{\n  \"relevant\": true or false,\n  \"tool\": \"loan\", \"calorie\", \"days\" or null,\n  \"reason\": \"short explanation\"\n}"
            }
          ]
        },
        "options": {
          "responseFormat": "json_object"
        }
      },
      "id": "node_check_relevance",
      "name": "Check Relevance",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [
        400,
        200
      ],
      "credentials": {
        "openAiApi": {
          "id": "iyAwc7psa2pV01rD",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ JSON.parse($json.output[0].content[0].text).relevant }}",
              "rightValue": true,
              "operator": "equals"
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node_if_relevant",
      "name": "If Relevant",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        650,
        200
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "content": "=News item to write about:\nTitle: {{ $('Get Latest Article').item.json.title }}\nSummary: {{ $('Get Latest Article').item.json.contentSnippet }}"
            },
            {
              "role": "system",
              "content": "=You are an expert copywriter. Generate a high-quality article responding to this news. The article must relate to the tool: {{ JSON.parse($('Check Relevance').item.json.output[0].content[0].text).tool }}.\nEnsure the output is in JSON format matching this exact schema:\n{\n  \"title\": \"Catchy SEO Page Title (under 60 chars)\",\n  \"metaDescription\": \"Compelling description (under 155 chars)\",\n  \"category\": \"Finance, Health, or Productivity\",\n  \"headline\": \"Powerful, engaging headline for the article\",\n  \"body\": \"HTML formatted article body using <p>, <h2>, <ul>, <li>. Do not write full html page, just the article body. Must be highly informative, professional, and contain 3-4 paragraphs with solid advice.\",\n  \"slug\": \"url-safe-lowercase-slug-without-html-extension (e.g. mortgage-rates-spike)\",\n  \"embeddedCalculatorLink\": \"<a href=\\\"../calculators/loan.html\\\" class=\\\"btn btn-primary\\\">Open Loan & Interest Calculator &rarr;</a>\" (select matching tool path: loan.html, calorie.html, or days.html)\n}"
            }
          ]
        },
        "options": {
          "responseFormat": "json_object"
        }
      },
      "id": "node_generate_content",
      "name": "Generate Article Content",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [
        850,
        200
      ],
      "credentials": {
        "openAiApi": {
          "id": "iyAwc7psa2pV01rD",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://raw.githubusercontent.com/RamidiRavi/Calculator/main/article-template.html",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            {
              "name": "Authorization",
              "value": "token YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
            }
          ]
        }
      },
      "id": "node_fetch_template",
      "name": "Fetch HTML Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const aiData = JSON.parse($('Generate Article Content').item.json.output[0].content[0].text);\nconst template = $('Fetch HTML Template').item.json.data;\nconst todayStr = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });\n\n// Replace hooks\nlet compiledHtml = template\n  .replace(/{title}/g, aiData.title)\n  .replace(/{meta-description}/g, aiData.metaDescription)\n  .replace(/{category}/g, aiData.category)\n  .replace(/{date}/g, todayStr)\n  .replace(/{article-headline}/g, aiData.headline)\n  .replace(/{article-body}/g, aiData.body)\n  .replace(/{embedded-calculator-link}/g, aiData.embeddedCalculatorLink);\n\nreturn {\n  html: compiledHtml,\n  slug: aiData.slug,\n  title: aiData.headline,\n  summary: aiData.metaDescription,\n  category: aiData.category,\n  date: todayStr\n};"
      },
      "id": "node_compile_html",
      "name": "Compile HTML File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        200
      ]
    },
    {
      "parameters": {
        "authentication": "pat",
        "resource": "file",
        "operation": "create",
        "owner": "RamidiRavi",
        "repository": "Calculator",
        "branch": "main",
        "filePath": "=articles/{{ $json.slug }}.html",
        "fileContent": "={{ $json.html }}",
        "commitMessage": "=Auto-publish article: {{ $json.title }}"
      },
      "id": "node_commit_html",
      "name": "Push HTML to GitHub",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        1500,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://raw.githubusercontent.com/RamidiRavi/Calculator/main/articles.json",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            {
              "name": "Authorization",
              "value": "token YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
            }
          ]
        }
      },
      "id": "node_fetch_json",
      "name": "Fetch Articles Index",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1700,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "let articles = [];\ntry {\n  articles = JSON.parse($('Fetch Articles Index').item.json.data);\n} catch (e) {\n  articles = [];\n}\n\nconst compiled = $('Compile HTML File').item.json;\n\n// Add new article metadata to the top\narticles.unshift({\n  title: compiled.title,\n  summary: compiled.summary,\n  url: `articles/${compiled.slug}.html`,\n  date: compiled.date,\n  category: compiled.category\n});\n\n// Cap at 30 articles to prevent file growing too large\nif (articles.length > 30) {\n  articles = articles.slice(0, 30);\n}\n\nreturn {\n  jsonContent: JSON.stringify(articles, null, 2)\n};"
      },
      "id": "node_update_json",
      "name": "Update JSON Index",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        200
      ]
    },
    {
      "parameters": {
        "authentication": "pat",
        "resource": "file",
        "operation": "edit",
        "owner": "RamidiRavi",
        "repository": "Calculator",
        "branch": "main",
        "filePath": "articles.json",
        "fileContent": "={{ $json.jsonContent }}",
        "commitMessage": "Update articles.json index"
      },
      "id": "node_commit_json",
      "name": "Push JSON to GitHub",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        2100,
        200
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get RSS Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get RSS Feed": {
      "main": [
        [
          {
            "node": "Get Latest Article",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Latest Article": {
      "main": [
        [
          {
            "node": "Check Relevance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Relevance": {
      "main": [
        [
          {
            "node": "If Relevant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Relevant": {
      "main": [
        [
          {
            "node": "Generate Article Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Article Content": {
      "main": [
        [
          {
            "node": "Fetch HTML Template",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch HTML Template": {
      "main": [
        [
          {
            "node": "Compile HTML File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compile HTML File": {
      "main": [
        [
          {
            "node": "Push HTML to GitHub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Push HTML to GitHub": {
      "main": [
        [
          {
            "node": "Fetch Articles Index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Articles Index": {
      "main": [
        [
          {
            "node": "Update JSON Index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update JSON Index": {
      "main": [
        [
          {
            "node": "Push JSON to GitHub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": null,
  "pinData": {}
}
